<view class="recharge-page data-v-723b7266"><view class="recharge-section data-v-723b7266"><block wx:if="{{showTip}}"><view class="tip-container data-v-723b7266"><text class="tip-text data-v-723b7266">{{currentTip}}</text></view></block><view class="stone-options data-v-723b7266"><button data-event-opts="{{[['tap',[['selectStone',[5]]]]]}}" class="{{['stone-btn','data-v-723b7266',(selectedStone===5)?'active':'']}}" bindtap="__e">50灵石</button><button data-event-opts="{{[['tap',[['selectStone',[9]]]]]}}" class="{{['stone-btn','data-v-723b7266',(selectedStone===9)?'active':'']}}" bindtap="__e">1000灵石</button><button data-event-opts="{{[['tap',[['selectStone',[35]]]]]}}" class="{{['stone-btn','data-v-723b7266',(selectedStone===35)?'active':'']}}" bindtap="__e">500灵石</button><button data-event-opts="{{[['tap',[['selectStone',[60]]]]]}}" class="{{['stone-btn','data-v-723b7266',(selectedStone===60)?'active':'']}}" bindtap="__e">1000灵石</button></view><text class="amount-tip data-v-723b7266">{{"应付金额："+amount+"元"}}</text><button class="pay-btn data-v-723b7266" disabled="{{isPayLoading}}" data-event-opts="{{[['tap',[['handlePay',['$event']]]]]}}" bindtap="__e"><block wx:if="{{!isPayLoading}}"><text class="data-v-723b7266">付款</text></block><block wx:if="{{isPayLoading}}"><text class="data-v-723b7266">支付中...</text></block></button></view></view>