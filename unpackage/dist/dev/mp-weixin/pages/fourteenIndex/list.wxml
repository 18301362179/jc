<view class="match-list data-v-0eb4d0d8"><block wx:for="{{finalDrawerList}}" wx:for-item="drawer" wx:for-index="drawerIdx" wx:key="drawerIdx"><view class="drawer-wrapper data-v-0eb4d0d8"><view class="date-title sticky-header data-v-0eb4d0d8" style="{{'top:'+(0+'rpx')+';'}}" hover-class="none" data-event-opts="{{[['tap',[['toggleDrawer',[drawerIdx]]]]]}}" bindtap="__e"><view class="drawer-title-text data-v-0eb4d0d8">{{drawer.title}}</view><view class="{{['arrow-icon','data-v-0eb4d0d8',(expandedDrawers[drawerIdx])?'rotated':'']}}">↓</view></view><view hidden="{{!(expandedDrawers[drawerIdx])}}" class="drawer-content data-v-0eb4d0d8"><block wx:for="{{drawer.lotteryList}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="match-row data-v-0eb4d0d8"><view class="main-content-row data-v-0eb4d0d8"><view class="main-left data-v-0eb4d0d8"><view class="match-num-wrapper data-v-0eb4d0d8"><text class="match-num data-v-0eb4d0d8">{{"第"+item.match_num+"场"}}</text></view></view><view class="main-right data-v-0eb4d0d8"><view class="top-right data-v-0eb4d0d8"><view class="team-vs data-v-0eb4d0d8"><text class="team-name home data-v-0eb4d0d8">{{item.home_name}}</text><text class="vs-text data-v-0eb4d0d8">VS</text><text class="team-name away data-v-0eb4d0d8">{{item.visiting_name}}</text></view><block wx:if="{{item.home_win_rate||item.visiting_win_rate}}"><view class="rate-row data-v-0eb4d0d8"><block wx:if="{{item.home_win_rate}}"><text class="rate-text home data-v-0eb4d0d8">{{"胜率"+(item.home_win_rate||'')+"%"}}</text></block><text class="vs-text data-v-0eb4d0d8"></text><block wx:if="{{item.visiting_win_rate}}"><text class="rate-text away data-v-0eb4d0d8">{{"胜率"+(item.visiting_win_rate||'')+"%"}}</text></block><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({item})}}" class="ai-analysis-btn data-v-0eb4d0d8" catchtap="__e">分析</view></view></block></view><view class="bottom-right data-v-0eb4d0d8"><view class="score-btn-group data-v-0eb4d0d8"><view class="{{['score-btn','data-v-0eb4d0d8',(item.homeSelected)?'selected':'']}}" hover-class="none" data-event-opts="{{[['tap',[['toggleScoreBtn',['$0','homeSelected'],[[['finalDrawerList','',drawerIdx],['lotteryList','id',item.id]]]]]]]}}" bindtap="__e">3</view><view class="{{['score-btn','data-v-0eb4d0d8',(item.vsSelected)?'selected':'']}}" hover-class="none" data-event-opts="{{[['tap',[['toggleScoreBtn',['$0','vsSelected'],[[['finalDrawerList','',drawerIdx],['lotteryList','id',item.id]]]]]]]}}" bindtap="__e">1</view><view class="{{['score-btn','data-v-0eb4d0d8',(item.awaySelected)?'selected':'']}}" hover-class="none" data-event-opts="{{[['tap',[['toggleScoreBtn',['$0','awaySelected'],[[['finalDrawerList','',drawerIdx],['lotteryList','id',item.id]]]]]]]}}" bindtap="__e">0</view></view></view></view></view></view></block></view></view></block></view>