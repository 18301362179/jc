.draw-num-selector.data-v-5e5d05ee {
  position: fixed;
  left: 0;
  width: 100%;
  height: 70rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eee;
  z-index: 999;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}
.rule-btn.data-v-5e5d05ee {
  font-size: 28rpx;
  color: #d92929;
  padding: 10rpx;
}
.selector-wrap.data-v-5e5d05ee {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx;
}
.current-num.data-v-5e5d05ee {
  color: #333;
}
.current-num.data-v-5e5d05ee:empty {
  color: #999;
}
.arrow-icon.data-v-5e5d05ee {
  font-size: 24rpx;
  transition: -webkit-transform 0.2s;
  transition: transform 0.2s;
  transition: transform 0.2s, -webkit-transform 0.2s;
}
.arrow-rotate.data-v-5e5d05ee {
  -webkit-transform: rotate(180deg);
          transform: rotate(180deg);
}
.dropdown-menu.data-v-5e5d05ee {
  position: absolute;
  top: 70rpx;
  right: 24rpx;
  background: #fff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  z-index: 1000;
  min-width: 120rpx;
}
.dropdown-item.data-v-5e5d05ee {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
}
.dropdown-item.active.data-v-5e5d05ee {
  background: #f5f5f5;
  color: #d92929;
}
.dropdown-item.data-v-5e5d05ee:active {
  background: #f0f0f0;
}
.empty-item.data-v-5e5d05ee {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

