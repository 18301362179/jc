<view class="match-list data-v-1db3f310" style="{{'padding-top:'+(paddingTopVal+'rpx')+';'}}"><block wx:for="{{finalDrawerList}}" wx:for-item="drawer" wx:for-index="drawerIdx" wx:key="drawerIdx"><view class="drawer-wrapper data-v-1db3f310"><view data-event-opts="{{[['tap',[['toggleDrawer',[drawerIdx]]]]]}}" class="date-title sticky-header data-v-1db3f310" style="{{'top:'+(stickyHeaderTop+'rpx')+';'}}" bindtap="__e"><text class="data-v-1db3f310">{{drawer.title}}</text><view class="{{['arrow-icon','data-v-1db3f310',(expandedDrawers[drawerIdx])?'rotated':'']}}">↓</view></view><view hidden="{{!(expandedDrawers[drawerIdx])}}" class="drawer-content data-v-1db3f310"><block wx:for="{{drawer.lotteryList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="match-row data-v-1db3f310" style="background:#f6f6f6;"><view class="match-status-row data-v-1db3f310"><view class="status-left data-v-1db3f310"><block wx:if="{{item.is_sf_single==1&&item.is_stop==0}}"><text class="single-tag data-v-1db3f310">单</text></block><block wx:if="{{item.is_stop==1}}"><text class="single-tag data-v-1db3f310" style="background:#dedede;">停</text></block></view><view class="status-right data-v-1db3f310"><block wx:if="{{item.home_win_rate&&item.visiting_win_rate}}"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({item})}}" class="{{['ai-analysis-btn','data-v-1db3f310',(item.is_buy!==0)?'x-text-green':'']}}" catchtap="__e">{{''+(item.is_buy==0?'1币比分+析':'比分+析')}}</view></block></view></view><view class="main-content-row data-v-1db3f310"><view class="main-left data-v-1db3f310"><view class="top-left data-v-1db3f310"><text class="league-name data-v-1db3f310">{{item.league_name}}</text></view><view class="bottom-left data-v-1db3f310"><text class="serial-number data-v-1db3f310">{{item.serial_number}}</text><text class="match-time data-v-1db3f310">{{item.race_date}}</text></view></view><view class="main-right data-v-1db3f310"><view class="top-right data-v-1db3f310"><view class="team-name data-v-1db3f310"><text class="data-v-1db3f310">{{item.visiting_name}}</text><text class="vs-text data-v-1db3f310">VS</text><text class="data-v-1db3f310">{{item.home_name}}</text></view><view class="rate-row data-v-1db3f310"><block wx:if="{{item.visiting_win_rate}}"><text class="rate-text away data-v-1db3f310">{{"胜率"+(item.visiting_win_rate||"--")}}</text></block><text class="vs-text data-v-1db3f310"></text><block wx:if="{{item.home_win_rate}}"><text class="rate-text home data-v-1db3f310">{{"胜率"+(item.home_win_rate||"--")}}</text></block></view></view><view class="bottom-right data-v-1db3f310"><view class="odds-trigger-area data-v-1db3f310"><view class="odds-row data-v-1db3f310"><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" data-event-params="{{({item})}}" class="{{['match-cell','away','data-v-1db3f310',(item.awaySelected)?'selected':'',(item.is_stop==1)?'stop-cell':'']}}" bindtap="__e">{{'主负'+(item.loss_multiplier||"--")+''}}</view><view data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" data-event-params="{{({item})}}" class="{{['match-cell','home','data-v-1db3f310',(item.homeSelected)?'selected':'',(item.is_stop==1)?'stop-cell':'']}}" bindtap="__e">{{'主胜'+(item.win_multiplier||"--")+''}}</view></view></view></view></view></view></view></block></view></view></block></view>