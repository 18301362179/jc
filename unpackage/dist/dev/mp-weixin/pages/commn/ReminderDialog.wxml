<block wx:if="{{isShow}}"><view class="reminder-dialog data-v-5069efc0"><view class="dialog-content data-v-5069efc0"><text class="dialog-title data-v-5069efc0">{{title}}</text><text class="dialog-message data-v-5069efc0">{{message}}</text><view class="dialog-buttons data-v-5069efc0"><button data-event-opts="{{[['tap',[['handleCancel',['$event']]]]]}}" class="dialog-btn cancel-btn data-v-5069efc0" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['handleExchange',['$event']]]]]}}" class="dialog-btn exchange-btn data-v-5069efc0" bindtap="__e">兑换</button></view></view></view></block>