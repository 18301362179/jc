<block wx:if="{{isShowStatus}}"><view class="bet-bar data-v-811e58ea"><view class="bet-bar-content data-v-811e58ea"><block wx:if="{{showClearBtn}}"><view data-event-opts="{{[['tap',[['handleClear',['$event']]]]]}}" class="clear-btn data-v-811e58ea" bindtap="__e"><image class="trash-icon data-v-811e58ea" src="/static/trash.png" mode="widthFix"></image></view></block><view class="tip-text data-v-811e58ea"><block wx:if="{{selectedCount>0}}"><label class="count-info _span data-v-811e58ea">已选<text class="red-text data-v-811e58ea">{{selectedCount}}</text>场，
        还差<text class="red-text data-v-811e58ea">{{$root.g0}}</text>场</label></block><block wx:else><label class="_span data-v-811e58ea">{{title||'至少选择'+minMatchCount+'场比赛'}}</label></block></view><button class="confirm-btn data-v-811e58ea" disabled="{{!confirmBtnEnabled}}" data-event-opts="{{[['tap',[['handleConfirm',['$event']]]]]}}" bindtap="__e">选好了</button></view></view></block>