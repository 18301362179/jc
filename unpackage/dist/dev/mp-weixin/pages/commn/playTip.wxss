.tips-popup-container.data-v-6852a41e {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999999;
  display: flex;
  justify-content: center;
  align-items: center;
}
.popup-mask.data-v-6852a41e {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
}
.popup-content.data-v-6852a41e {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
  padding: 2rpx;
  background-color: v-bind(borderColor);
  max-height: v-bind('maxHeight + "vh"');
  overflow-y: auto;
}
.popup-content.data-v-6852a41e::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 10rpx;
  z-index: -1;
}
