.item.data-v-05b3db04 {
  padding: 0 20rpx;
  border-radius: 2rpx;
}
.item .time.data-v-05b3db04 {
  font-size: 24rpx;
  color: #777;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 40rpx;
}
.item .time .ai.data-v-05b3db04 {
  font-size: 22rpx;
  color: #06f;
  padding: 6rpx 16rpx;
  cursor: pointer;
  transition: opacity 0.2s;
  white-space: nowrap;
  letter-spacing: 4rpx;
}
.item .time .ai.data-v-05b3db04:active {
  opacity: 0.8;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05);
}
.item.data-v-05b3db04:nth-child(even) {
  background: #f2f2f2;
}
.score.data-v-05b3db04 {
  width: 100%;
  min-height: 70rpx;
  display: flex;
  align-items: center;
  /* 左右区域 + 冒号 总宽度100% */
}
/* 左侧区域：占比 (100% - 冒号宽度)/2 */
.left-area.data-v-05b3db04 {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  /* 内容右对齐（贴近冒号） */
  padding-right: 10rpx;
  /* 与冒号保持原有间距 */
}
/* 右侧区域：占比 (100% - 冒号宽度)/2 */
.right-area.data-v-05b3db04 {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  /* 内容左对齐（贴近冒号） */
  padding-left: 10rpx;
  /* 与冒号保持原有间距 */
}
/* 左侧小项容器（自动撑开） */
