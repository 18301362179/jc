<view class="custom-header data-v-aee3dd8e" style="{{'padding-top:'+(statusBarHeight+'px')+';'}}"><view class="header-content data-v-aee3dd8e"><block wx:if="{{showBack}}"><view class="header-left data-v-aee3dd8e"><view data-event-opts="{{[['tap',[['onBackClick',['$event']]]]]}}" class="header-back data-v-aee3dd8e" bindtap="__e"><image class="back-icon data-v-aee3dd8e" src="https://www.tianjifu.com/static/back.png" mode="aspectFit"></image></view></view></block><block wx:if="{{showIcon}}"><view class="header-left data-v-aee3dd8e"><view data-event-opts="{{[['tap',[['onFunnelClick',['$event']]]]]}}" class="header-back data-v-aee3dd8e" bindtap="__e"><image class="funnel-icon data-v-aee3dd8e" src="https://www.tianjifu.com/static/funnel.png" mode="aspectFit"></image></view></view></block><view class="header-middle data-v-aee3dd8e"><block wx:if="{{isIndex}}"><view class="prefix-text data-v-aee3dd8e">{{ballTitle}}</view></block><view data-event-opts="{{[['tap',[['triggerSelect',['$event']]]]]}}" class="core-content data-v-aee3dd8e" bindtap="__e"><text class="content-text data-v-aee3dd8e">{{isSelected?selectedPlay||title:title}}</text><block wx:if="{{isSelected}}"><view class="triangle-icon data-v-aee3dd8e"></view></block></view></view></view></view>