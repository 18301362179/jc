<block wx:if="{{visible}}"><view data-event-opts="{{[['tap',[['close',['$event']]]]]}}" class="modal-mask data-v-acf450d4" bindtap="__e"><view class="modal-box data-v-acf450d4"><view class="modal-header data-v-acf450d4"><text class="title data-v-acf450d4">{{msg.ms_title||'系统通知'}}</text><text class="time data-v-acf450d4">{{msg.ms_time||''}}</text></view><view class="modal-content data-v-acf450d4"><view class="content-text data-v-acf450d4">{{msg.ms_content||'暂无内容'}}</view></view><view class="modal-footer data-v-acf450d4"><button class="close-btn data-v-acf450d4" loading="{{loading}}" data-event-opts="{{[['tap',[['handleKnow',['$event']]]]]}}" bindtap="__e">我知道了</button></view></view></view></block>