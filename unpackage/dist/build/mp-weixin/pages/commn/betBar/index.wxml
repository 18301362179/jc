<view class="bet-bar data-v-04c6b21e"><view class="bet-bar-content data-v-04c6b21e"><block wx:if="{{showClearBtn}}"><view data-event-opts="{{[['tap',[['handleClear',['$event']]]]]}}" class="clear-btn data-v-04c6b21e" bindtap="__e"><image class="trash-icon data-v-04c6b21e" src="https://www.tianjifu.com/static/trash.png" mode="widthFix"></image></view></block><view class="tip-text data-v-04c6b21e"><block wx:if="{{selectedCount>0}}"><label class="count-info _span data-v-04c6b21e">已选<text class="red-text data-v-04c6b21e">{{selectedCount}}</text>场，
