<view class="draw-num-selector data-v-4f59fa2e" style="{{'top:'+(navBarTotalHeight+'rpx')+';'}}"><view class="rule-btn data-v-4f59fa2e">{{title}}</view><view data-event-opts="{{[['tap',[['toggleDropdown',['$event']]]]]}}" class="selector-wrap data-v-4f59fa2e" bindtap="__e"><text class="current-num data-v-4f59fa2e">{{currentDrawNum?currentDrawNum+'期':"暂无"}}</text><text class="{{['arrow-icon','data-v-4f59fa2e',(isDropdownShow)?'arrow-rotate':'']}}">▼</text></view><block wx:if="{{isDropdownShow}}"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="dropdown-menu data-v-4f59fa2e" catchtap="__e"><block wx:if="{{$root.g0===0}}"><view class="empty-item data-v-4f59fa2e">暂无</view></block><block wx:else><block wx:for="{{drawNumList}}" wx:for-item="num" wx:for-index="__i0__" wx:key="*this"><view data-event-opts="{{[['tap',[['selectDrawNum',['$0'],[[['drawNumList','',__i0__]]]]]]]}}" class="{{['dropdown-item','data-v-4f59fa2e',(num===currentDrawNum)?'active':'']}}" bindtap="__e">{{''+num+'期'}}</view></block></block></view></block></view>