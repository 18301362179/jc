.empty-container{display:flex;justify-content:center;align-items:center;height:60vh;padding:20rpx}.empty-container .empty-card{width:100%;max-width:500rpx;background:#fff;border-radius:24rpx;padding:60rpx 40rpx;display:flex;flex-direction:column;align-items:center;position:relative;overflow:hidden}.empty-container .empty-icon{width:180rpx;height:180rpx;margin-bottom:40rpx;opacity:.9}.empty-container .empty-wave{position:absolute;top:0;left:0;width:100%;height:10rpx;overflow:hidden}.empty-container .empty-wave .wave{width:200%;height:100%;background:linear-gradient(90deg,rgba(100,175,255,.5),rgba(65,145,255,.8) 50%,rgba(100,175,255,.5));-webkit-animation:wave 2s linear infinite;animation:wave 2s linear infinite}.empty-container .empty-title{font-size:36rpx;font-weight:500;color:#333;margin-bottom:16rpx}.empty-container .empty-desc{font-size:28rpx;color:#999;text-align:center;margin-bottom:40rpx}.empty-container .empty-button{background:linear-gradient(135deg,#5b8cff,#3a6eff);color:#fff;border:none;border-radius:50rpx;padding:0 60rpx;height:80rpx;line-height:80rpx;font-size:30rpx;box-shadow:0 6rpx 12rpx rgba(58,110,255,.2);transition:all .3s}.empty-container .empty-button:active{-webkit-transform:scale(.95);transform:scale(.95);opacity:.9}@-webkit-keyframes wave{0%{-webkit-transform:translateX(-50%);transform:translateX(-50%)}100%{-webkit-transform:translateX(0);transform:translateX(0)}}@keyframes wave{0%{-webkit-transform:translateX(-50%);transform:translateX(-50%)}100%{-webkit-transform:translateX(0);transform:translateX(0)}}